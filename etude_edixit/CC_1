#La Banque Postale a deux codes banques possibles. On précise que l'IBAN doit commencer par FR
#car sinon certains virements sont identifiés 'intra' à tort (N26 en Allemagne)
#Pour les opérations par RIB, il n'y a pas de code pays. Donc on estime que ces opérations
#sont uniquement réalisés en France donc les codes banques sont bien ceux de La Banque Postale

est_intra_recus_iban = (((F.substring(F.col("numero_compte_emetteur"), 5, 5) == "20041") |
                         (F.substring(F.col("numero_compte_emetteur"), 5, 5) == "10011")) &
                         (F.col('numero_compte_emetteur').startswith("FR")) &
                         (F.col('format_enregistrement_compte_emetteur') == "IBAN"))

est_intra_recus_rib =  (((F.substring(F.col("numero_compte_emetteur"), 1, 5) == "20041") |
                         (F.substring(F.col("numero_compte_emetteur"), 1, 5) == "10011")) &
                         (F.col('format_enregistrement_compte_emetteur') == "RIB"))

est_intra_recus = (est_intra_recus_iban | est_intra_recus_rib)

est_intra_emis_iban = (((F.substring(F.col("numero_compte_beneficiaire"), 5, 5) == "20041") |
                         (F.substring(F.col("numero_compte_beneficiaire"), 5, 5) == "10011")) &
                         (F.col('numero_compte_beneficiaire').startswith("FR")) &
                         (F.col('format_enregistrement_compte_beneficiaire') == "IBAN"))

est_intra_emis_rib =  (((F.substring(F.col("numero_compte_beneficiaire"), 1, 5) == "20041") |
                         (F.substring(F.col("numero_compte_beneficiaire"), 1, 5) == "10011")) &
                         (F.col('format_enregistrement_compte_beneficiaire') == "RIB"))

est_intra_emis = (est_intra_emis_iban | est_intra_emis_rib)

