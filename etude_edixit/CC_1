# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# Tables sources et Dates à laquelle on veut réaliser les études des clients

borne_inf = "20260101"
borne_sup = "20260630"
date_part_sup = "202606"

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# Read recipe inputs
bloc_contrat = dataiku.Dataset("bloc_contrat_cur_ext")
bloc_contrat = dkuspark.get_dataframe(sqlContext, bloc_contrat)

bloc_seg = dataiku.Dataset("bloc_seg_cur_ext")
bloc_seg = dkuspark.get_dataframe(sqlContext, bloc_seg)

bloc_gammes_produits = dataiku.Dataset("bloc_gammes_produits_cur_ext")
bloc_gammes_produits = dkuspark.get_dataframe(sqlContext, bloc_gammes_produits)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
filtre_gamme = (
    ((F.col("gamme") == "AQ") & (F.col("sous_gamme") == "CCP")) |
    #((F.col("gamme") == "EPA_ORD") & (F.col("sous_gamme") == "CAT")) |
    #((F.col("gamme") == "EPA_ORD") & (F.col("sous_gamme") == "COMPTE_ATTENTE")) |
    ((F.col("gamme") == "EPA_ORD") & (F.col("sous_gamme") == "COMPTE_SUR_LIVRET")) |
    ((F.col("gamme") == "EPA_ORD") & (F.col("sous_gamme") == "LDD")) |
    ((F.col("gamme") == "EPA_ORD") & (F.col("sous_gamme") == "LEP")) |
    ((F.col("gamme") == "EPA_ORD") & (F.col("sous_gamme") == "LIVRET_A")) |
    ((F.col("gamme") == "EPA_ORD") & (F.col("sous_gamme") == "LIVRET_B")) |
    ((F.col("gamme") == "EPA_ORD") & (F.col("sous_gamme") == "LIVRET_JEUNE")) |
    #((F.col("gamme") == "EPA_ORD") & (F.col("sous_gamme") == "PEP")) |
    ((F.col("gamme") == "EPA_LOG") & (F.col("sous_gamme") == "CEL")) |
    #((F.col("gamme") == "EPA_LOG") & (F.col("sous_gamme") == "COMPOSE")) |
    #((F.col("gamme") == "EPA_LOG") & (F.col("sous_gamme") == "PEL"))
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
gammes_produits = (
    bloc_gammes_produits
    .filter((F.col("annee_mois_part") == date_part_sup) & filtre_gamme) # Sinon redondance des sous_gammes
    .select('cd_cnt_typ', 'gamme', 'sous_gamme')
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
bloc_contrat_annee = (
    bloc_contrat
    .filter((F.col("annee_mois_part") >= borne_inf)
            & (F.col("annee_mois_part") <= borne_sup)
           )
    .select('id_prs', 'num_cnt_com', 'cd_cnt_typ', 'cd_typ_ttl', 'nbr_titulaire', 'annee_mois_part')
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
bloc_seg_annee = (
    bloc_seg
    .filter((F.col("annee_mois_part") >= borne_inf) &
            (F.col("annee_mois_part") <= borne_sup) &
            (F.col("cd_seg_com_top_dcd") == 0)
           )
    .select('id_prs', 'annee_mois_part')
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
perimetre_client = (
    bloc_contrat_annee
    .join(bloc_seg_annee, on=['id_prs', 'annee_mois_part'], how='inner')
    .join(gammes_produits, on=['cd_cnt_typ'], how='inner')
    .join(gammes_produits_ccepargne, on=['cd_cnt_typ'], how='inner')
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
windowSpec = Window.partitionBy('id_prs','num_cnt_com').orderBy(F.col("annee_mois_part").desc())

dernier_vision = (
    perimetre_client
        .select('id_prs','num_cnt_com','annee_mois_part').distinct()
        .withColumn("rank",rank().over(windowSpec))
        .filter(F.col("rank")==1)
        .drop("rank")
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
perimetre_client_vf = (
    perimetre_client
    .join(dernier_vision, on=['id_prs','num_cnt_com','annee_mois_part'], how='inner')
)




