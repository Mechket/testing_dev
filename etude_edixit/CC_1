# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
table_virements_safran = (
    te_virements_safran
    .filter((F.col("code_type_operation").isin('SCT', 'VIR'))
         & (F.col("date_execution_demandee_pour_operation") >= borne_inf) # date_execution_demandee_pour_operation à modifier pour être cohérent avec annee_mois_part
         & (F.col("date_execution_demandee_pour_operation") <= borne_sup) # date_execution_demandee_pour_operation à modifier pour être cohérent avec annee_mois_part
         & (F.col('date_part') >= date_part)
         & (F.col('identifiant_operation').isNotNull())
           )
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
window = Window.partitionBy('identifiant_operation').orderBy(F.col('timestamp_gdo').desc())

virements_safran = (
    table_virements_safran
    .withColumn('rank', F.rank().over(window))
    .filter(F.col('rank') == 1)
    .drop('rank')

    .filter((F.col('type_de_personne_emetteur_operation')!='2') # uniquement PPH
#              & (F.col('canal_acquisition_operation')!="FIA") Enlève tous les virements permanents ? Flux intra applications
          )
    .withColumn('statut', F.trim(F.col('code_statut_operation')))
    .withColumn('montant', F.col('montant_operation') / 100)
    .withColumn('num_cnt_com', (F.when((F.col("sens_operation") == 'E') &
                                       (F.col('format_enregistrement_compte_emetteur') == "RIB"),
                                       F.substring('numero_compte_emetteur', 11, 11))
                                 .when((F.col("sens_operation") == 'E') &
                                      (F.col('format_enregistrement_compte_emetteur') == 'IBAN'),
                                      F.substring('numero_compte_emetteur', 15, 11))
                                 .when((F.col("sens_operation") == 'R') &
                                       (F.col('format_enregistrement_compte_beneficiaire') == "RIB"),
                                       F.substring('numero_compte_beneficiaire', 11, 11))
                                 .when((F.col("sens_operation") == 'R') &
                                      (F.col('format_enregistrement_compte_beneficiaire') == 'IBAN'),
                                      F.substring('numero_compte_beneficiaire', 15, 11))
                               )
               )
    .withColumn("canal", F.when(F.col("canal_acquisition_operation").isin("BEL","APP","P2P","TPP"),"BEL")
                          .otherwise(F.col("canal_acquisition_operation"))
               )
    .withColumn("annee_mois_part", F.substring('date_execution_demandee_pour_operation', 0, 6))
    .withColumnRenamed("date_acquisition_operation", "date_acquisition")
    .withColumnRenamed("date_execution_demandee_pour_operation", "date_execution")
    .withColumn("type_personne_beneficiaire_operation", F.trim(F.col("type_personne_beneficiaire_operation")))
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
virements_safran_vf = (
    virements_safran
    .join(perimetre_contrat, on=['num_cnt_com'], how='inner')
    .withColumn('poids', F.when(F.col("nbr_titulaire") >= 2 , 0.5).otherwise(1))
    .withColumn('typ_virement', F.when(F.col("identifiant_operation").startswith("0226"), 'Permanent') # virement régulier
                                 .otherwise('Ponctuel')
               )
    .select('id_prs', 'num_cnt_com','gamme', 'sous_gamme', 'identifiant_operation', 'sens_operation',
