from pyspark.sql.types import IntegerType
from pyspark.sql.functions import expr

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
sparkSession = (SparkSession
                .builder.appName('CAC_hub_download')
                .master('yarn-client')
                .config("spark.driver.maxResultSize", '8g')
                .config('spark.driver.memory', '8g')
                .config('spark.executor.memory', '8g')
                .config('spark.executor.instances', 30)
                .config('spark.sql.autoBroadcastJoinThreshold',-1)
                .enableHiveSupport()
                .getOrCreate()
               )

sc = SparkContext.getOrCreate()
sqlContext = SQLContext(sc)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
PROJECT_KEY = dataiku.default_project_key() # Nom du projet dans lequel on se trouve

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: MARKDOWN
# Tables sources et Dates à laquelle on veut réaliser les études des clients

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
#VARIABLES
borne_inf = "20260101"
borne_sup = "20260630"
date_part = 202601

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: MARKDOWN
# L'objet de ce notebook est d'obtenir tous les virements instantanés sous format émis et reçus.

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# Read recipe inputs
t_dlk_pivot_legacy = dataiku.Dataset("t_dlk_pivot_legacy")
t_dlk_pivot_legacy = dkuspark.get_dataframe(sqlContext, t_dlk_pivot_legacy)

perimetre_contrat = dataiku.Dataset("perimetre_contrat")
perimetre_contrat = dkuspark.get_dataframe(sqlContext, perimetre_contrat)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
perimetre_contrat = perimetre_contrat.drop("annee_mois_part")

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
table_virements_inst = (
    t_dlk_pivot_legacy
    .filter((F.col("dtprench") >= borne_inf)
                 & (F.col("dtprench") <= borne_sup)
                 & (F.col('date_part') >= date_part)
                 & (F.col('norobext').isNotNull())
                 & (F.col('typarten')!='E')
           )
    .withColumn('id_ope', F.trim(F.col('norobext')))
    .withColumn('priority', F.when(F.col('cdidecro')=='PCI',1)
                                 .when(F.col('cdidecro')=='ABN',2)
                                 .when(F.col('cdidecro')=='EKO',3)
                                 .when(F.col('cdidecro')=='RJT',4)
                                 .when(F.col('cdidecro')=='IMP',5)
                                 .when(F.col('cdidecro')=='RTI',6)
                                 .when(F.col('cdidecro')=='NTR',7)
                                 .when(F.col('cdidecro')=='ATC',8)
                                 .when(F.col('cdidecro')=='ECH',9)
                                 .otherwise(10)
                    )
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
window = Window.partitionBy('id_ope').orderBy(F.col('priority').asc())

virements_inst = (
    table_virements_inst
    .withColumn('rank', F.rank().over(window))
    .filter(F.col('rank') == 1)
    .drop('rank')

    .withColumn('iban',F.when(F.col('cdopeint')=='VIO', F.col('cdibaemt'))
                        .when(F.col('cdopeint')=='VIB', F.col('cdibades'))
               )
    .withColumn('sens_operation',F.when((F.col('cdopeint')=='VIO'), "E")
                                  .when((F.col('cdopeint')=='VIB'), "R")
               )
    .withColumn('num_cnt_com', F.substring('iban', 15, 11)
               )
    .withColumn('nature_compte', F.when(F.substring('iban', 5, 5)=='10011','EPA').otherwise('CCP')
                )
    .withColumn('montant', F.col('mtoperat1_calc') / 100)
    .withColumn('rejet', F.when(F.col('cdidecro').isin('PCI', 'NTR', 'RJT', 'ABN', 'EKO'), 'Rejeté')
                          .otherwise('Non rejeté')
                )
    .withColumn("annee_mois_part", F.substring('dtprench', 0,6))
    .withColumnRenamed("dtprench", "date_execution")

    .withColumn('canal_acquisition_operation', F.trim(F.col('cdcanacq')))
    .withColumn("canal", F.when(F.col("cdcanacq").isin("BEL","APP","P2P","TPP"),"BEL")
                          .otherwise(F.col("cdcanacq"))
               )
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
virements_inst_vf = (
    virements_inst
    .join(perimetre_contrat, on=['num_cnt_com'], how='inner')
    .withColumn('poids', F.when(F.col("nbr_titulaire") >= 2, 0.5).otherwise(1))
    .select('id_prs', 'num_cnt_com', 'gamme', 'sous_gamme', 'id_ope', 'sens_operation', 'poids', 'nmlibemt',
            'cdtypemt', 'cdibaemt', 'cdbicemt', 'nmlibdes', 'cdtypdes', 'cdibades', 'cdbicdes', 'canal_acquisition_operation', 'canal',
            'montant', 'date_execution', 'annee_mois_part') 
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# virements_inst_vf.persist()
# virements_inst_vf.count()

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
#La Banque Postale a deux codes banques possibles. On précise que l'IBAN doit commencer par FR
#car sinon certains virements sont identifiés 'intra' à tort (N26 en Allemagne)

est_intra_recus = (((F.substring(F.col("cdibaemt"), 5, 5) == "20041") |
                   (F.substring(F.col("cdibaemt"), 5, 5) == "10011")) &
                   (F.col('cdibaemt').startswith("FR")))

est_intra_emis = (((F.substring(F.col("cdibades"), 5, 5) == "20041") |
                   (F.substring(F.col("cdibades"), 5, 5) == "10011")) &
                   (F.col('cdibades').startswith("FR")))

est_doublon = ()

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
perimetre_contrat_gamme = (
    perimetre_contrat
    .select('num_cnt_com', 'gamme', 'sous_gamme')
    .distinct()
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# Virements émis
Hub_inst_emis_df = (
    virements_inst_vf
    .filter(((F.col("sens_operation") == "E")) & (F.col('rejet')=='Non rejeté')) # Virements exécutés et émis
    .withColumn('intra_inter', F.when(est_intra_emis, 'intra')
                                .otherwise('inter'))
    .withColumnRenamed('num_cnt_com', 'num_cnt_com_emt')
    .withColumnRenamed('gamme', 'gamme_emt')
    .withColumnRenamed('sous_gamme', 'sous_gamme_emt')
    .withColumn('num_cnt_com_des', F.when(est_intra_emis, F.substring('cdibades', 15, 11))
                                    .otherwise(None))
    .join(perimetre_contrat_gamme, F.col('num_cnt_com_des')== perimetre_contrat_gamme['num_cnt_com'], how='left')
#     .distinct()
    .withColumnRenamed('gamme', 'gamme_des')
    .withColumnRenamed('sous_gamme', 'sous_gamme_des')
    .withColumn('nature_virement', F.when(((F.col('sous_gamme_emt') == "CCP") &
                                          ((F.col('gamme_des') == 'EPA_ORD') | (F.col('gamme_des') == 'EPA_LOG'))),
                                          'CCP_to_EPA')
                                    .when((((F.col('gamme_emt') == 'EPA_ORD') | (F.col('gamme_emt') == 'EPA_LOG')) &
                                            (F.col('sous_gamme_des') == "CCP")),
                                          'EPA_to_CCP')
                                    .when(((F.col('sous_gamme_emt') == "CCP") & (F.col('sous_gamme_des') == "CCP")),
                                          'CCP_to_CCP')
                                    .when((((F.col('gamme_emt') == "EPA_ORD") | (F.col('gamme_emt') == "EPA_LOG")) &
                                          ((F.col('gamme_des') == "EPA_ORD") | (F.col('gamme_des') == "EPA_LOG"))),
                                          'EPA_to_EPA')
                                    .when(((F.col('intra_inter') == "intra") & (F.col('gamme_des').isNull())),
                                          'Contrat_clos_et_autre'))
                                    # Certains contrats n'ont pas de gamme, la plupart du temps c'est que ce sont des contrats clos

    .select('id_prs', 'id_ope', 'poids', 'sens_operation', 'nature_virement', 'num_cnt_com_emt', 'gamme_emt',
            'sous_gamme_emt', 'nmlibemt', 'cdtypemt', 'cdibaemt', 'cdbicemt', 'num_cnt_com_des', 'gamme_des', 'sous_gamme_des',
            'nmlibdes', 'cdtypdes', 'cdibades', 'cdbicdes', 'intra_inter', 'canal_acquisition_operation', 'canal', 'montant',
            'date_execution', 'annee_mois_part'
           )
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# Virements reçus
Hub_inst_recus_df = (
    virements_inst_vf
    .filter(((F.col("sens_operation") == "R")) & (F.col('rejet')=='Non rejeté')) # Virements exécutés et reçus
    .filter(~est_intra_recus) # On enlève les intra pour éviter la redondance avec les virements émis
    .withColumn('intra_inter', F.when(est_intra_recus, 'intra')
                                .otherwise('inter'))
    .withColumnRenamed('num_cnt_com', 'num_cnt_com_des')
    .withColumnRenamed('gamme', 'gamme_des')
    .withColumnRenamed('sous_gamme', 'sous_gamme_des')
    .withColumn('num_cnt_com_emt', F.when(est_intra_recus, F.substring('cdibaemt', 15, 11))
                                    .otherwise(None))
    .join(perimetre_contrat_gamme, F.col('num_cnt_com_emt') == perimetre_contrat_gamme['num_cnt_com'], how='left')
    .withColumnRenamed('gamme', 'gamme_emt')
    .withColumnRenamed('sous_gamme', 'sous_gamme_emt')
    .withColumn('nature_virement', F.when(((F.col('sous_gamme_emt') == "CCP") &
                                          ((F.col('gamme_des') == 'EPA_ORD') | (F.col('gamme_des') == 'EPA_LOG'))),
                                          'CCP_to_EPA')
                                    .when((((F.col('gamme_emt') == 'EPA_ORD') | (F.col('gamme_emt') == 'EPA_LOG')) &
                                            (F.col('sous_gamme_des') == "CCP")),
                                          'EPA_to_CCP')
                                    .when(((F.col('sous_gamme_emt') == "CCP") & (F.col('sous_gamme_des') == "CCP")),
                                          'CCP_to_CCP')
                                    .when((((F.col('gamme_emt') == "EPA_ORD") | (F.col('gamme_emt') == "EPA_LOG")) &
                                          ((F.col('gamme_des') == "EPA_ORD") | (F.col('gamme_des') == "EPA_LOG"))),
                                          'EPA_to_EPA')
                                    .when(((F.col('intra_inter') == "intra") & (F.col('gamme_emt').isNull())),
                                          'Contrat_clos_et_autre'))
                                    # Certains contrats n'ont pas de gamme, la plupart du temps c'est que ce sont des contrats clos

    .select('id_prs', 'id_ope', 'poids', 'sens_operation', 'nature_virement', 'num_cnt_com_emt', 'gamme_emt',
            'sous_gamme_emt', 'nmlibemt', 'cdtypemt', 'cdibaemt', 'cdbicemt', 'num_cnt_com_des', 'gamme_des', 'sous_gamme_des',
            'nmlibdes', 'cdtypdes', 'cdibades', 'cdbicdes', 'intra_inter', 'canal_acquisition_operation', 'canal', 'montant',
