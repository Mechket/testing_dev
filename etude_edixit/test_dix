def get_freq(df1, df2, variable):
    "Permet d'obtenir la répartition des modalités pour chaque variable à chaque date"

    if df1.count() > 0 and df2.count() > 0:
        tableau = (
            df1
            .withColumn('origin', F.lit(1))
            .union(df2.withColumn('origin', F.lit(2)))
            .crosstab(variable, 'origin')
            .toPandas()
        )
        tableau['perc_pop1'] = tableau['1'].div(tableau['1'].sum())
        tableau['perc_pop2'] = tableau['2'].div(tableau['2'].sum())
        tableau['excel_variable'] =  variable + '_' + tableau[variable+'_origin'].astype(str)
        tableau['indicateur'] = variable
    elif df1.count() > 0:
        df2 = df1
        tableau = (
            df1
            .withColumn('origin', F.lit(1))
            .union(df2.withColumn('origin', F.lit(2)))
            .crosstab(variable, 'origin')
            .toPandas()
        )
        tableau['perc_pop1'] = tableau['1'].div(tableau['1'].sum())
        tableau['perc_pop2'] = tableau['1']*0
        tableau['excel_variable'] =  variable + '_' + tableau[variable+'_origin'].astype(str)
        tableau['indicateur'] = variable
    elif df2.count() > 0:
        df1 = df2
        tableau = (
            df1
            .withColumn('origin', F.lit(1))
            .union(df2.withColumn('origin', F.lit(2)))
            .crosstab(variable, 'origin')
            .toPandas()
        )
        tableau['perc_pop1'] = tableau['2']*0
        tableau['perc_pop2'] = tableau['2'].div(tableau['2'].sum())
        tableau['excel_variable'] =  variable + '_' + tableau[variable+'_origin'].astype(str)
        tableau['indicateur'] = variable
    else:
        tableau = pd.DataFrame({'indicateur': [variable], 'excel_variable': [variable+ '_.'], 'perc_pop1': [0.0], 'perc_pop2': [0.0]})

    return tableau.loc[:,['indicateur', 'excel_variable', 'perc_pop1', 'perc_pop2']]

