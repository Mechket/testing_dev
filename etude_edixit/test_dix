        temp_2 = temp_2.reset_index().append({'cd_seg_com_engag_aff_cd_seg_com_marche_aff_av_fra':str(i), 'A':0, 'B':0, 'C':0, 'D':0, 'E':0, 'F':0}, ignore_index=True).set_index('cd_seg_com_engag_aff_cd_seg_com_marche_aff_av_fra')

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
nouvelle_seg = pd.DataFrame(columns = ['iable', 'n_pop_1', 'n_pop_2'], dtype = float)
