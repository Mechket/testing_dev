    ws.row_dimensions[1].height = 25

    ws.merge_cells(start_row=2, start_column=1, end_row=2, end_column=NB_COLS)
    ws.cell(row=2, column=1).value = (
        "Comparaison bénéficiaires / non-bénéficiaires "
        "autour du mois d'entretien"
    )
    ws.cell(row=2, column=1).font = Font(italic=True, color="666666")

    # --------------------------------------------------------
    # CALCULS
    # --------------------------------------------------------

    stats_global = calculer_bloc(metric, mois=None)

    stats_par_mois = {
        mois: calculer_bloc(metric, mois=mois)
        for mois in MOIS_ENTRETIEN
    }

    # --------------------------------------------------------
    # ZONE DE DONNEES DES GRAPHIQUES (à droite)
    #
    # Colonnes, dans l'ordre :
    #   [Horizon]
    #   [Global bénéf.] [Global non-bénéf.]
    #   [Mois1 bénéf.] [Mois1 non-bénéf.] ... (détail)
    #   [Mois1 écart] [Mois2 écart] ...      (écarts)
    # --------------------------------------------------------

    ligne_entete_graph = 4
    derniere_ligne_graph = ligne_entete_graph + len(HORIZONS)

    c = ws.cell(row=ligne_entete_graph, column=COL_GRAPH)
    c.value = "Horizon"
    c.font = Font(bold=True, color=BLANC)
    c.fill = PatternFill("solid", fgColor=VERT_FONCE)
    c.alignment = Alignment(horizontal="center")

    for i, horizon in enumerate(HORIZONS.keys(), start=1):
        cell = ws.cell(row=ligne_entete_graph + i, column=COL_GRAPH)
        cell.value = horizon
        cell.font = Font(bold=True)
        cell.alignment = Alignment(horizontal="center")

    def ecrire_serie(col, libelle, valeurs_par_horizon):
        """Écrit une colonne de série dans la zone de données."""

        c = ws.cell(row=ligne_entete_graph, column=col)
        c.value = libelle
        c.font = Font(bold=True, size=9)
        c.alignment = Alignment(horizontal="center", wrap_text=True)

        for i, horizon in enumerate(HORIZONS.keys(), start=1):
            cell = ws.cell(row=ligne_entete_graph + i, column=col)
            cell.value = valeurs_par_horizon[horizon]
            cell.number_format = '0.0%'

    col = COL_GRAPH + 1

    # Bloc 1 : global
    col_global_debut = col
    ecrire_serie(col, "Bénéficiaires", stats_global[CLE_EVO_B])
    col += 1
    ecrire_serie(col, "Non-bénéficiaires", stats_global[CLE_EVO_N])
    col_global_fin = col
    col += 1

    # Bloc 2 : détail par mois (2 séries par mois)
    col_detail_debut = col
    for mois in MOIS_ENTRETIEN:
        ecrire_serie(col, f"{mois} bénéf.", stats_par_mois[mois][CLE_EVO_B])
        col += 1
        ecrire_serie(col, f"{mois} non-bénéf.", stats_par_mois[mois][CLE_EVO_N])
        col += 1
    col_detail_fin = col - 1

    # Bloc 3 : écart d'évolution par mois (1 série par mois)
    col_ecart_debut = col
    for mois in MOIS_ENTRETIEN:
        ecrire_serie(col, f"{mois}", stats_par_mois[mois][CLE_EVO_E])
        col += 1
    col_ecart_fin = col - 1

    derniere_col_serie = col_ecart_fin

    # --------------------------------------------------------
    # GRAPHIQUES
    # --------------------------------------------------------

    ligne_graphique = derniere_ligne_graph + 3

    definitions = {
        "global": (
            f"{metric} — évolution vs M (tous mois confondus)",
            col_global_debut, col_global_fin, False
        ),
        "ecart_par_mois": (
            f"{metric} — écart d'évolution bénéf. − non-bénéf. "
            f"(points de %)",
            col_ecart_debut, col_ecart_fin, False
        ),
        "detail_par_mois": (
            f"{metric} — évolution vs M par mois d'entretien",
            col_detail_debut, col_detail_fin, True
        ),
    }

    for cle_graphe in GRAPHES:

        if cle_graphe not in definitions:
            print(f"  Graphique inconnu ignoré : {cle_graphe}")
            continue

        titre_g, cmin, cmax, par_paire = definitions[cle_graphe]

        chart = creer_graphique(
            ws, metric, titre_g,
            cmin, cmax,
            ligne_entete_graph, derniere_ligne_graph,
            COL_GRAPH,
            couleurs_par_paire=par_paire
        )

        ws.add_chart(
            chart,
            f"{get_column_letter(COL_GRAPH)}{ligne_graphique}"
        )

        ligne_graphique += 19

    # --------------------------------------------------------
    # TABLEAU RECAPITULATIF GLOBAL
    # --------------------------------------------------------

    ligne = 4

    ligne = ecrire_tableau(
        ws, ligne, metric,
        "RÉCAPITULATIF GLOBAL — tous mois d'entretien confondus",
        stats_global,
        ROUGE
    )

    ligne += 2

    # --------------------------------------------------------
    # UN TABLEAU PAR MOIS D'ENTRETIEN
    # --------------------------------------------------------

    for mois in MOIS_ENTRETIEN:

        ligne = ecrire_tableau(
            ws, ligne, metric,
            f"Mois d'entretien : {mois}",
            stats_par_mois[mois],
            BLEU_FONCE
        )

        ligne += 2

    # ========================================================
    # LARGEUR DES COLONNES
    # ========================================================

    ws.column_dimensions["A"].width = 34

    for col_i in range(2, NB_COLS + 1):
        ws.column_dimensions[get_column_letter(col_i)].width = 16

    ws.column_dimensions[get_column_letter(COL_GRAPH)].width = 12

    for col_i in range(COL_GRAPH + 1, derniere_col_serie + 1):
        ws.column_dimensions[get_column_letter(col_i)].width = 13

    # ========================================================
    # FIGER LES VOLETS
    # ========================================================

    ws.freeze_panes = "B5"


# ============================================================
# 15. SAUVEGARDE
# ============================================================

wb.save(FICHIER_SORTIE)

print("\n" + "=" * 60)
print("TERMINÉ")
print("=" * 60)
print(f"Fichier créé : {Path(FICHIER_SORTIE).resolve()}")
