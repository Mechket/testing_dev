def creer_graphique(ws, metric, titre, min_col, max_col,
                    ligne_entete, derniere_ligne, col_categories,
                    couleurs_par_paire=False):
    """
    Crée un graphique en courbes à partir d'un bloc de colonnes
    contigu de la zone de données.
    """

    chart = LineChart()
    chart.title = titre
    chart.style = 2
    chart.y_axis.title = "Évolution vs M"
    chart.x_axis.title = "Horizon"
    chart.y_axis.numFmt = '0%'
    chart.height = 9
    chart.width = 20

    data_ref = Reference(
        ws,
        min_col=min_col,
        max_col=max_col,
        min_row=ligne_entete,
        max_row=derniere_ligne
    )

    cats_ref = Reference(
        ws,
        min_col=col_categories,
        min_row=ligne_entete + 1,
        max_row=derniere_ligne
    )

    chart.add_data(data_ref, titles_from_data=True)
    chart.set_categories(cats_ref)

    for i, serie in enumerate(chart.series):

        serie.smooth = False

        if couleurs_par_paire:
            # 2 séries par mois : même couleur, pointillé pour non-bénéf.
            serie.graphicalProperties.line.solidFill = \
                PALETTE[(i // 2) % len(PALETTE)]
            if i % 2 == 1:
                serie.graphicalProperties.line.dashStyle = "dash"
                serie.graphicalProperties.line.width = 16000
            else:
                serie.graphicalProperties.line.width = 22000
        else:
            serie.graphicalProperties.line.solidFill = \
                PALETTE[i % len(PALETTE)]
            serie.graphicalProperties.line.width = 22000

    return chart


