def calculer_statistiques(df, colonne, mois=None):
    """
    Calcule nombre, moyenne, total (somme) et médiane.
    Si mois vaut None, calcul sur l'ensemble des mois d'entretien.
    """

    if colonne not in df.columns:
        return {
            "nombre": np.nan,
            "moyenne": np.nan,
            "total": np.nan,
            "mediane": np.nan
        }

    if mois is None:
        subset = df[colonne]
    else:
        subset = df[df[COLONNE_MOIS_ENTRETIEN] == mois][colonne]

    subset = pd.to_numeric(subset, errors="coerce").dropna()

    if len(subset) == 0:
        return {
            "nombre": 0,
            "moyenne": np.nan,
            "total": np.nan,
            "mediane": np.nan
        }

    return {
        "nombre": len(subset),
        "moyenne": subset.mean(),
        "total": subset.sum(),
        "mediane": subset.median()
    }


def evolution_pct(valeur, valeur_ref):
    """
    Évolution en % (fraction : 0.12 = +12 %) par rapport à M.
    """

    if pd.isna(valeur) or pd.isna(valeur_ref):
        return np.nan

    if valeur_ref == 0:
        return np.nan

    return (valeur - valeur_ref) / abs(valeur_ref)


def format_cellule(metric, nom_ligne):
    """
    Détermine le format Excel d'une cellule selon la métrique
    et le type de ligne.
    """

    if "Nombre" in nom_ligne:
        return FORMAT_NOMBRE

    if metric in METRIQUES_NON_EURO:
        return FORMAT_DECIMAL

    return FORMAT_EURO


