import unicodedata
import dataiku
from pyspark.sql.types import *
from dataiku import spark as dkuspark
from pyspark import SparkContext,SparkConf
from pyspark.sql import SQLContext
from pyspark.sql import SparkSession, HiveContext
import pandas as pd
import pyspark.sql.functions as F
from pyspark.sql.window import Window
import random
from pyspark.sql.functions import udf
from pyspark.sql.types import IntegerType
from pyspark.sql.functions import expr

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
sparkSession = (SparkSession
                .builder.appName('CAC_hub_sct_download')
                .master('yarn-client')
                .config("spark.driver.maxResultSize", '10g')
                .config('spark.driver.memory', '10g')
                .config('spark.executor.memory', '2g')
                .config('spark.executor.instances', 12)
                .config('spark.sql.autoBroadcastJoinThreshold',-1)
                .enableHiveSupport()
                .getOrCreate()
               )

sc = SparkContext.getOrCreate()
sqlContext = SQLContext(sc)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
borne_inf = "20260101"
borne_sup = "20260630"
date_part = 202601

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# Read recipe inputs
te_virements_safran = dataiku.Dataset("te_virements_safran")
te_virements_safran = dkuspark.get_dataframe(sqlContext, te_virements_safran)

# ADAPTÉ : table de référence large (CCP + épargne)
ref_contrats_ccp_epargne = dataiku.Dataset("ref_contrats_ccp_epargne")
perimetre_contrat = dkuspark.get_dataframe(sqlContext, ref_contrats_ccp_epargne)

# ADAPTÉ : périmètre client final (scope + flag Ccépargne)
perimetre_clients_epargne = dataiku.Dataset("perimetre_clients_epargne")
perimetre_clients_epargne_df = dkuspark.get_dataframe(sqlContext, perimetre_clients_epargne)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
table_virements_safran = (
    te_virements_safran
    .filter((F.col("code_type_operation").isin('SCT', 'VIR'))
         & (F.col("date_execution_demandee_pour_operation") >= borne_inf)
         & (F.col("date_execution_demandee_pour_operation") <= borne_sup)
         & (F.col('date_part') >= date_part)
         & (F.col('identifiant_operation').isNotNull())
           )
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
window = Window.partitionBy('identifiant_operation').orderBy(F.col('timestamp_gdo').desc())

virements_safran = (
    table_virements_safran
    .withColumn('rank', F.rank().over(window))
    .filter(F.col('rank') == 1)
    .drop('rank')
    .filter((F.col('type_de_personne_emetteur_operation')!='2'))
    .withColumn('statut', F.trim(F.col('code_statut_operation')))
    .withColumn('montant', F.col('montant_operation') / 100)
    .withColumn('num_cnt_com', (F.when((F.col("sens_operation") == 'E') &
                                       (F.col('format_enregistrement_compte_emetteur') == "RIB"),
                                       F.substring('numero_compte_emetteur', 11, 11))
                                 .when((F.col("sens_operation") == 'E') &
                                      (F.col('format_enregistrement_compte_emetteur') == 'IBAN'),
                                      F.substring('numero_compte_emetteur', 15, 11))
                                 .when((F.col("sens_operation") == 'R') &
                                       (F.col('format_enregistrement_compte_beneficiaire') == "RIB"),
                                       F.substring('numero_compte_beneficiaire', 11, 11))
                                 .when((F.col("sens_operation") == 'R') &
                                      (F.col('format_enregistrement_compte_beneficiaire') == 'IBAN'),
                                      F.substring('numero_compte_beneficiaire', 15, 11))
                               )
               )
    .withColumn("canal", F.when(F.col("canal_acquisition_operation").isin("BEL","APP","P2P","TPP"),"BEL")
                          .otherwise(F.col("canal_acquisition_operation")))
    .withColumn("annee_mois_part", F.substring('date_execution_demandee_pour_operation', 0, 6))
    .withColumnRenamed("date_acquisition_operation", "date_acquisition")
    .withColumnRenamed("date_execution_demandee_pour_operation", "date_execution")
    .withColumn("type_personne_beneficiaire_operation", F.trim(F.col("type_personne_beneficiaire_operation")))
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
virements_safran_vf = (
    virements_safran
    .join(perimetre_contrat, on=['num_cnt_com'], how='inner')
    .withColumn('poids', F.when(F.col("nbr_titulaire") >= 2 , 0.5).otherwise(1))
    .withColumn('typ_virement', F.when(F.col("identifiant_operation").startswith("0226"), 'Permanent')
                                 .otherwise('Ponctuel'))
    .select('id_prs', 'num_cnt_com','gamme', 'sous_gamme', 'identifiant_operation', 'sens_operation',
            'typ_virement', 'poids', 'statut', 'canal_acquisition_operation', 'canal', 'montant',
            'date_acquisition', 'date_execution', 'annee_mois_part',
            'numero_compte_emetteur', 'numero_compte_beneficiaire',
            'format_enregistrement_compte_emetteur', 'format_enregistrement_compte_beneficiaire')
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
est_intra_recus_iban = (((F.substring(F.col("numero_compte_emetteur"), 5, 5) == "20041") |
                         (F.substring(F.col("numero_compte_emetteur"), 5, 5) == "10011")) &
                         (F.col('numero_compte_emetteur').startswith("FR")) &
                         (F.col('format_enregistrement_compte_emetteur') == "IBAN"))

est_intra_recus_rib =  (((F.substring(F.col("numero_compte_emetteur"), 1, 5) == "20041") |
                         (F.substring(F.col("numero_compte_emetteur"), 1, 5) == "10011")) &
                         (F.col('format_enregistrement_compte_emetteur') == "RIB"))

est_intra_recus = (est_intra_recus_iban | est_intra_recus_rib)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
perimetre_contrat_gamme = (
    perimetre_contrat
    .select('num_cnt_com', 'gamme', 'sous_gamme')
    .distinct()
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# Virements reçus (compte perimeter = destinataire)
virements_sct_recus = (
    virements_safran_vf
    .filter(((F.col('statut')=="EXE")) & (F.col("sens_operation")=='R'))
    .filter(~est_intra_recus)
    .withColumn('intra_inter', F.when(est_intra_recus, 'intra').otherwise('inter'))
    .withColumnRenamed('num_cnt_com', 'num_cnt_com_des')
    .withColumnRenamed('gamme', 'gamme_des')
    .withColumnRenamed('sous_gamme', 'sous_gamme_des')
    .withColumn('num_cnt_com_emt', F.when(est_intra_recus &
                                           (F.col('format_enregistrement_compte_emetteur') == "RIB"),
                                            F.substring('numero_compte_emetteur', 11,11))
                                     .when(est_intra_recus &
                                           (F.col('format_enregistrement_compte_emetteur') == 'IBAN'),
                                            F.substring('numero_compte_emetteur', 15,11))
                                     .otherwise(None))
    .join(perimetre_contrat_gamme, F.col('num_cnt_com_emt') == perimetre_contrat_gamme['num_cnt_com'], how='left')
    .withColumnRenamed('gamme', 'gamme_emt')
    .withColumnRenamed('sous_gamme', 'sous_gamme_emt')
    .withColumn('nature_virement', F.when(((F.col('sous_gamme_emt') == "CCP") &
                                      ((F.col('gamme_des') == 'EPA_ORD') | (F.col('gamme_des') == 'EPA_LOG'))),
                                      'CCP_to_EPA')
                                    .when((((F.col('gamme_emt') == 'EPA_ORD') | (F.col('gamme_emt') == 'EPA_LOG')) &
                                        (F.col('sous_gamme_des') == "CCP")),
                                      'EPA_to_CCP')
                                    .when(((F.col('sous_gamme_emt') == "CCP") & (F.col('sous_gamme_des') == "CCP")),
                                      'CCP_to_CCP')
                                    .when((((F.col('gamme_emt') == "EPA_ORD") | (F.col('gamme_emt') == "EPA_LOG")) &
                                      ((F.col('gamme_des') == "EPA_ORD") | (F.col('gamme_des') == "EPA_LOG"))),
                                      'EPA_to_EPA')
                                    .when(((F.col('intra_inter') == "intra") & (F.col('gamme_emt').isNull())),
                                      'Contrat_clos_et_autre'))

    .select('id_prs', 'identifiant_operation', 'poids', 'typ_virement', 'nature_virement',
            'num_cnt_com_des', 'gamme_des', 'sous_gamme_des',
            'canal_acquisition_operation', 'canal', 'montant', 'date_acquisition', 'date_execution', 'annee_mois_part')
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# NOUVEAU : filtre CCP_to_EPA + flag Ccépargne
virements_sct_ccp_to_epa_df = (
    virements_sct_recus
    .filter(F.col('nature_virement') == 'CCP_to_EPA')
    .join(perimetre_clients_epargne_df.select('id_prs', 'top_ccepargne').distinct(), on=['id_prs'], how='inner')
)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# Write recipe outputs
virements_sct_ccp_to_epa = dataiku.Dataset("virements_sct_ccp_to_epa")
dkuspark.write_with_schema(virements_sct_ccp_to_epa, virements_sct_ccp_to_epa_df)
