def verifier_colonnes(df, nom_dataset):
    """
    Vérifie que la colonne mois d'entretien existe
    et affiche les colonnes manquantes.
    """

    if COLONNE_MOIS_ENTRETIEN not in df.columns:
        raise ValueError(
            f"La colonne '{COLONNE_MOIS_ENTRETIEN}' "
            f"n'existe pas dans le dataset {nom_dataset}."
        )

    colonnes_manquantes = []

    for metric in METRICS:
        for horizon, suffixe in HORIZONS.items():

            colonne = f"{metric}{suffixe}"

            if colonne not in df.columns:
                colonnes_manquantes.append(colonne)

    if colonnes_manquantes:
        print(
            f"\nATTENTION - colonnes manquantes dans {nom_dataset} :"
        )

        for colonne in colonnes_manquantes:
            print(f" - {colonne}")

    return colonnes_manquantes


