# ============================================================
# 6. FONCTION DE CALCUL DES STATISTIQUES
# ============================================================

def calculer_statistiques(df, colonne, mois):
    """
    Calcule :
    - nombre d'observations
    - moyenne
    - médiane

    pour un mois d'entretien donné.
    """

    if colonne not in df.columns:
        return {
            "nombre": np.nan,
            "moyenne": np.nan,
            "mediane": np.nan
        }

    subset = df[
        df[COLONNE_MOIS_ENTRETIEN] == mois
    ][colonne]

    # Conversion numérique
    subset = pd.to_numeric(
        subset,
        errors="coerce"
    ).dropna()

    if len(subset) == 0:
        return {
            "nombre": 0,
            "moyenne": np.nan,
            "mediane": np.nan
        }

    return {
        "nombre": len(subset),
        "moyenne": subset.mean(),
        "mediane": subset.median()
    }


