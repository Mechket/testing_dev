# -*- coding: utf-8 -*-
"""
Recette gestes co : rattachement des gestes aux personnes, choix d'une personne par geste,
indicateurs d'eligibilite.

Sorties :
- benef_gestes_co        : 1 ligne par geste (personne retenue), SANS filtre -> entree du script de metriques
- cli_gestes_co          : id_prs distincts ayant eu au moins un geste
- benef_gestes_co_janv26 : id_prs distincts ayant eu un geste en janvier 2026
                           ET presents dans le socle seg en 12/2025 ET en 08/2026

Regle de choix de la personne (comptes joints) :
  1 personne derriere le contrat -> cette personne
  sinon -> la personne eligible (critere direct OU lien familial eligible)
  si plusieurs eligibles (ou aucune) -> la plus engagee (cd_seg_com_engag_stb le plus eleve)
"""
import dataiku
from dataiku import spark as dkuspark
from pyspark import SparkContext
from pyspark.sql import SQLContext, SparkSession
import pyspark.sql.functions as F
from pyspark.sql.window import Window

sparkSession = (SparkSession
                .builder.appName("gestes_co")
                .master("yarn-client")
                .config("spark.driver.maxResultSize", "2g")
                .config("spark.driver.memory", "2g")
                .config("spark.executor.memory", "2g")
                .config("spark.executor.instances", 5)
                .config("spark.sql.autoBroadcastJoinThreshold", -1)
                .enableHiveSupport()
                .getOrCreate())
sc = SparkContext.getOrCreate()
sqlContext = SQLContext(sc)

# =============================================================================
# Parametres
# =============================================================================
MOIS_DEB, MOIS_FIN = 202501, 202608
MOIS_GESTE_CIBLE = 202601                 # gestes de janvier 2026
MOIS_SOCLE_1, MOIS_SOCLE_2 = 202512, 202608  # presence requise dans le socle seg
DATE_MAX_LIEN = "2026-08-31"
TYPES_LIEN = ["D", "C"]                   # descendants / conjoints

FLAGS = ["TOP_Patrimoniaux", "TOP_Adultes_a_enjeux", "TOP_Jeunes", "TOP_MULTI_EQP"]
LIEN_FLAGS = ["TOP_LIEN_AVEC_" + c[4:] for c in FLAGS] + ["TOP_LIEN_ELIGIBLE"]


def lire(nom):
    return dkuspark.get_dataframe(sqlContext, dataiku.Dataset(nom))


gestes_src = lire("gestes_commerciaux")
contrat_src = lire("bloc_contrat_cur_ext")
seg_src = lire("bloc_seg_cur_ext")
liens_src = lire("lbp_al42_repr_pph_active_q")

# =============================================================================
# 1. Gestes : identifiant technique, numero de contrat, mois du geste
# =============================================================================
gestes = (
    gestes_src
    .withColumn("id_geste", F.monotonically_increasing_id())
    .withColumn(
        "num_cnt_ben",
        F.when(F.col("MEN_DIV_OPE").rlike(r"\d{3,5}$"),
               F.regexp_extract("MEN_DIV_OPE", r"\d{7}[A-Z]\d{3}", 0))
         .when(F.col("MEN_DIV_OPE").rlike(r"[A-Z]\d{0,2}$"),
               F.regexp_extract("MEN_DIV_OPE", r"\d{10}[A-Z]", 0)))
    # regexp_extract renvoie "" quand rien ne matche -> on remet a null
    .withColumn("num_cnt_ben", F.when(F.col("num_cnt_ben") != "", F.col("num_cnt_ben")))
    .withColumn("dt_geste", F.to_date(F.col("DT_CRE_EVT"), "ddMMMyyyy"))
    .withColumn("mois_geste", F.date_format("dt_geste", "yyyyMM").cast("int"))
    # le segment est lu sur le mois precedant le geste
    .withColumn("mois_seg_ref", F.date_format(F.add_months("dt_geste", -1), "yyyyMM").cast("int"))
)

# =============================================================================
# 2. Contrat -> personne(s) : derniere photo du contrat sur la periode
# =============================================================================
w_ctr = Window.partitionBy("num_cnt_com")
contrat = (
    contrat_src
    .filter(F.col("annee_mois_part").between(MOIS_DEB, MOIS_FIN))
    .select("num_cnt_com", "id_prs", "annee_mois_part").distinct()
    .withColumn("max_amp", F.max("annee_mois_part").over(w_ctr))
    .filter(F.col("annee_mois_part") == F.col("max_amp"))
    .select("num_cnt_com", "id_prs").distinct()
    .withColumn("nb_prs_contrat", F.count("id_prs").over(w_ctr))
)

# =============================================================================
# 3. Socle seg + criteres d'eligibilite directs (1 ligne par personne et par mois)
# =============================================================================
seg = (
    seg_src
    .filter(F.col("annee_mois_part").between(MOIS_DEB, MOIS_FIN))
    .select(F.col("id_prs").alias("id_prs_seg"),
            F.col("annee_mois_part").cast("int").alias("mois_seg"),
            F.col("cd_seg_com_engag_stb").cast("int").alias("cd_seg_com_engag_stb"),
            F.col("cd_seg_com_marche_aff_av_fra"))
    .dropDuplicates(["id_prs_seg", "mois_seg"])
    .withColumn("TOP_Patrimoniaux", (F.col("cd_seg_com_marche_aff_av_fra") == "A").cast("int"))
    .withColumn("TOP_Adultes_a_enjeux", (F.col("cd_seg_com_marche_aff_av_fra") == "B").cast("int"))
    .withColumn("TOP_Jeunes", F.col("cd_seg_com_marche_aff_av_fra").isin("D", "E").cast("int"))
    .withColumn("TOP_MULTI_EQP", (F.col("cd_seg_com_engag_stb") == 5).cast("int"))
    .fillna(0, subset=FLAGS)
    .withColumn("TOP_ELIG_DIRECT", F.greatest(*FLAGS))
    .cache()
)

# =============================================================================
# 4. Gestes x personnes x segment du mois precedent
# =============================================================================
benef = (
    gestes
    .join(contrat, gestes.num_cnt_ben == contrat.num_cnt_com, "left")
    .join(seg, (F.col("id_prs") == F.col("id_prs_seg"))
               & (F.col("mois_seg_ref") == F.col("mois_seg")), "left")
    .withColumn("TOP_PRESENT_SEG_REF", F.col("id_prs_seg").isNotNull().cast("int"))
    .drop("id_prs_seg", "mois_seg")
)

# =============================================================================
# 5. Eligibilite via un lien familial (conjoint / enfant eligible)
#    Agregee a 1 ligne par (personne, mois) AVANT le choix de la personne,
#    pour ne pas dupliquer les gestes quand une personne a plusieurs liens.
# =============================================================================
liens = (
    liens_src
    .filter(F.col("type_lien_partenaires").isin(TYPES_LIEN)
            & (F.to_date("date_de_creation") <= F.lit(DATE_MAX_LIEN)))
    .select(F.col("identifiant_partenaire").alias("id_prs"),
            F.col("identifiant_partenaire_lie").alias("id_prs_lie"))
    .distinct()
)

seg_lie = seg.select(F.col("id_prs_seg").alias("id_prs_lie"),
                     F.col("mois_seg").alias("mois_seg_ref"),
                     *[F.col(c).alias(c + "_lie") for c in FLAGS + ["TOP_ELIG_DIRECT"]])

elig_lien = (
    benef.select("id_prs", "mois_seg_ref").dropna().distinct()
    .join(liens, "id_prs")
    .join(seg_lie, ["id_prs_lie", "mois_seg_ref"])
    .groupBy("id_prs", "mois_seg_ref")
    .agg(*[F.max(c + "_lie").alias("TOP_LIEN_AVEC_" + c[4:]) for c in FLAGS],
         F.max("TOP_ELIG_DIRECT_lie").alias("TOP_LIEN_ELIGIBLE"))
)

benef = (
    benef.join(elig_lien, ["id_prs", "mois_seg_ref"], "left")
    .fillna(0, subset=FLAGS + ["TOP_ELIG_DIRECT"] + LIEN_FLAGS)
    .withColumn("TOP_ELIGIBLE", F.greatest("TOP_ELIG_DIRECT", "TOP_LIEN_ELIGIBLE"))
)

# =============================================================================
# 6. Choix d'une personne par geste
# =============================================================================
w_geste = Window.partitionBy("id_geste").orderBy(
    F.col("TOP_ELIGIBLE").desc(),                    # la personne eligible d'abord
    F.col("cd_seg_com_engag_stb").desc_nulls_last(), # puis la plus engagee
    F.col("TOP_ELIG_DIRECT").desc(),                 # departage : eligible en direct
    F.col("id_prs").asc_nulls_last())                # departage deterministe

benef = (
    benef
    .withColumn("rang", F.row_number().over(w_geste))
    .filter(F.col("rang") == 1).drop("rang")
    .withColumn("type_compte",
                F.when(F.col("nb_prs_contrat") == 1, "Individuel")
                 .when(F.col("nb_prs_contrat") >= 2, "Joint")
                 .otherwise("Contrat non retrouve"))
    # categorie exclusive (hierarchie a ajuster si besoin)
    .withColumn("categorie_eligibilite",
                F.when(F.col("id_prs").isNull(), "Contrat non retrouve")
                 .when(F.col("TOP_Patrimoniaux") == 1, "Patrimonial")
                 .when(F.col("TOP_Adultes_a_enjeux") == 1, "Adulte a enjeux")
                 .when(F.col("TOP_MULTI_EQP") == 1, "Multi-equipe")
                 .when(F.col("TOP_Jeunes") == 1, "Jeune")
                 .when(F.col("TOP_LIEN_ELIGIBLE") == 1, "Lien familial eligible")
                 .otherwise("Non eligible"))
)

# =============================================================================
# 7. Presence dans le socle seg en 12/2025 et 08/2026
# =============================================================================
def presents(mois, nom_col):
    return (seg.filter(F.col("mois_seg") == mois)
               .select(F.col("id_prs_seg").alias("id_prs")).distinct()
               .withColumn(nom_col, F.lit(1)))


benef = (
    benef
    .join(presents(MOIS_SOCLE_1, "TOP_PRESENT_SEG_202512"), "id_prs", "left")
    .join(presents(MOIS_SOCLE_2, "TOP_PRESENT_SEG_202608"), "id_prs", "left")
    .fillna(0, subset=["TOP_PRESENT_SEG_202512", "TOP_PRESENT_SEG_202608"])
)

# =============================================================================
# 8. Sorties
# =============================================================================
cli_gestes_co_df = benef.filter(F.col("id_prs").isNotNull()).select("id_prs").distinct()

cli_gestes_co_janv26_df = (
    benef.filter((F.col("mois_geste") == MOIS_GESTE_CIBLE)
                 & (F.col("TOP_PRESENT_SEG_202512") == 1)
                 & (F.col("TOP_PRESENT_SEG_202608") == 1))
    .select("id_prs").distinct()
)

# Controle rapide dans les logs : dates non parsees / contrats non extraits
ctrl = gestes.agg(F.count("*").alias("nb_gestes"),
                  F.sum(F.col("dt_geste").isNull().cast("int")).alias("nb_dates_non_parsees"),
                  F.sum(F.col("num_cnt_ben").isNull().cast("int")).alias("nb_contrats_non_extraits")).first()
print("CONTROLE GESTES :", ctrl.asDict())

dkuspark.write_with_schema(dataiku.Dataset("benef_gestes_co"), benef)
dkuspark.write_with_schema(dataiku.Dataset("cli_gestes_co"), cli_gestes_co_df)
dkuspark.write_with_schema(dataiku.Dataset("benef_gestes_co_janv26"), cli_gestes_co_janv26_df)
