# ============================== PARAMÈTRES À ADAPTER ==========================
DATASET_ENTREE = "gestes_co"            # nom du dataset d'entrée dans le flow
DOSSIER_SORTIE = "rapport_gestes_co"    # nom (ou id) du dossier géré de sortie
NOM_FICHIER = "descriptif_gestes_co_{}.xlsx".format(dt.date.today().strftime("%Y%m%d"))

COL_RIB = "men_div_ope"     # IBAN / RIB (FR...)
COL_DATE = "dt_cre_evt"     # date de l'événement (ex. 10JUN2026)
COL_CNT = "num_cnt_ben"     # numéro de contrat (sous-chaîne du RIB)
COL_PRS = "id_prs"          # id personne
COL_RANK = "rank"           # 1 = personne la plus engagée du contrat
COL_MNT = "mnt_ope"         # montant du geste co
COL_SEG = "cd_seg_com_engag_aff_M"  # segment d'engagement (ignoré s'il n'existe pas)

# Tranches de montant (en euros) : [0-10[, [10-20[, ..., 1000 et +
BORNES_MONTANT = [0, 10, 20, 50, 100, 200, 500, 1000]

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# ============================== PRÉPARATION ==================================
MOIS = {"jan": 1, "feb": 2, "fev": 2, "mar": 3, "apr": 4, "avr": 4, "may": 5, "mai": 5,
        "jun": 6, "jul": 7, "aug": 8, "aou": 8, "sep": 9, "oct": 10, "nov": 11, "dec": 12}


def parse_date(df, col):
    """Convertit '10JUN2026', '10 jun 2026', '10-JUN-26'... en date Spark.
    Accepte aussi une colonne déjà en date/timestamp, ou 'yyyy-MM-dd' / 'dd/MM/yyyy'."""
    type_col = dict(df.dtypes)[col]
    if type_col in ("date", "timestamp"):
        return df.withColumn("date_evt", F.to_date(F.col(col)))

    s = F.trim(F.col(col).cast("string"))
    regex = r"^(\d{1,2})[\s\-/\.]*([A-Za-zéÉûÛ]+)\.?[\s\-/\.]*(\d{2,4})"
    jour = F.regexp_extract(s, regex, 1)
    lib_mois = F.translate(F.lower(F.regexp_extract(s, regex, 2)), "éû", "eu")
    annee = F.regexp_extract(s, regex, 3)

    carte_mois = F.create_map(*[x for k, v in MOIS.items() for x in (F.lit(k), F.lit(v))])
    mois = (F.when(lib_mois.startswith("juil"), F.lit(7))
             .when(lib_mois.startswith("juin"), F.lit(6))
             .otherwise(carte_mois[F.substring(lib_mois, 1, 3)]))
    annee4 = F.when(F.length(annee) == 2, F.concat(F.lit("20"), annee)).otherwise(annee)

    date_texte = F.to_date(F.concat_ws("-", annee4, F.lpad(mois.cast("string"), 2, "0"),
                                       F.lpad(jour, 2, "0")), "yyyy-MM-dd")
    return df.withColumn("date_evt", F.coalesce(
        F.when(jour != "", date_texte),
        F.to_date(s, "yyyy-MM-dd"),
        F.to_date(s, "dd/MM/yyyy"),
    ))


def tranche_montant(col, bornes):
    expr = F.when(col.isNull(), F.lit("Montant manquant")).when(col < 0, F.lit("Négatif"))
    for i in range(len(bornes) - 1):
        lib = "{:02d}. [{} ; {}[".format(i + 1, bornes[i], bornes[i + 1])
        expr = expr.when(col < bornes[i + 1], F.lit(lib))
    return expr.otherwise(F.lit("{:02d}. {} et +".format(len(bornes), bornes[-1])))


def preparer(df):
    df = parse_date(df, COL_DATE)
    df = (df.withColumn(COL_MNT, F.col(COL_MNT).cast("double"))
            .withColumn("mois_evt", F.date_format("date_evt", "yyyy-MM"))
            .withColumn("tranche_mnt", tranche_montant(F.col(COL_MNT), BORNES_MONTANT)))

    # Nombre de personnes distinctes par contrat -> compte joint / individuel
    nb_prs = df.groupBy(COL_CNT).agg(F.countDistinct(COL_PRS).alias("nb_titulaires"))
    df = (df.join(nb_prs, on=COL_CNT, how="left")
            .withColumn("type_compte",
                        F.when(F.col("nb_titulaires") == 0, "Sans personne rattachée")
                         .when(F.col("nb_titulaires") == 1, "Individuel")
                         .when(F.col("nb_titulaires") == 2, "Joint (2 titulaires)")
                         .otherwise("Joint (3 titulaires et +)")))
    return df


def evenements(df):
    """Une ligne par geste co : on garde la personne de rang 1 (la plus engagée).
    Les contrats sans personne rattachée sont gardés (une seule ligne)."""
    ev = df.filter((F.col(COL_RANK) == 1) | F.col(COL_PRS).isNull())
    # Sécurité si plusieurs personnes sont ex aequo au rang 1
    w = Window.partitionBy(COL_RIB, COL_CNT, COL_DATE, COL_MNT).orderBy(F.col(COL_PRS).asc_nulls_last())
    return ev.withColumn("_rn", F.row_number().over(w)).filter(F.col("_rn") == 1).drop("_rn")


def stats_montant(df, prefixe=""):
    q = F.expr("percentile_approx({}, array(0.25, 0.5, 0.75), 10000)".format(COL_MNT))
    return [
        F.sum(COL_MNT).alias(prefixe + "montant_total"),
        F.avg(COL_MNT).alias(prefixe + "montant_moyen"),
        q.getItem(1).alias(prefixe + "montant_median"),
    ]

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# ============================== INDICATEURS ==================================


def calculer_tableaux(brut):
    df = preparer(brut).persist()
    ev = evenements(df).persist()
    tab = {}

    # --- Synthèse ---
    g = ev.agg(F.count("*").alias("n"), F.sum(COL_MNT).alias("tot"), F.avg(COL_MNT).alias("moy"),
               F.expr("percentile_approx({}, 0.5, 10000)".format(COL_MNT)).alias("med"),
               F.min(COL_MNT).alias("mini"), F.max(COL_MNT).alias("maxi"),
               F.min("date_evt").alias("d1"), F.max("date_evt").alias("d2")).collect()[0]
    contrats = df.select(COL_CNT, "type_compte").distinct().toPandas()
    synthese = [
        ("Période couverte", "{} au {}".format(g["d1"], g["d2"])),
        ("Nombre de gestes co", g["n"]),
        ("Nombre de contrats bénéficiaires", len(contrats)),
        ("  dont comptes individuels", int((contrats["type_compte"] == "Individuel").sum())),
        ("  dont comptes joints", int(contrats["type_compte"].str.startswith("Joint").sum())),
        ("Nombre de bénéficiaires principaux (rang 1)", ev.filter(F.col(COL_PRS).isNotNull()).select(COL_PRS).distinct().count()),
        ("Nombre de personnes concernées (tous titulaires)", df.filter(F.col(COL_PRS).isNotNull()).select(COL_PRS).distinct().count()),
        ("Montant total (€)", g["tot"]),
        ("Montant moyen (€)", g["moy"]),
        ("Montant médian (€)", g["med"]),
        ("Montant minimum (€)", g["mini"]),
        ("Montant maximum (€)", g["maxi"]),
    ]
    tab["Synthese"] = pd.DataFrame(synthese, columns=["Indicateur", "Valeur"])

    # --- Par mois ---
    par_mois = (ev.groupBy("mois_evt").agg(
        F.count("*").alias("nb_gestes"),
        F.countDistinct(COL_CNT).alias("nb_contrats"),
        F.countDistinct(COL_PRS).alias("nb_beneficiaires"),
        F.sum(F.when(F.col("type_compte").startswith("Joint"), 1).otherwise(0)).alias("nb_gestes_comptes_joints"),
        *stats_montant(ev)).toPandas().sort_values("mois_evt"))
    tous_titulaires = (df.groupBy("mois_evt").agg(F.countDistinct(COL_PRS).alias("nb_personnes_tous_titulaires"))
                         .toPandas())
    par_mois = par_mois.merge(tous_titulaires, on="mois_evt", how="left")
    par_mois["part_comptes_joints"] = par_mois["nb_gestes_comptes_joints"] / par_mois["nb_gestes"]
    par_mois["nb_gestes_cumules"] = par_mois["nb_gestes"].cumsum()
    par_mois["montant_cumule"] = par_mois["montant_total"].cumsum()
    par_mois["mois_evt"] = par_mois["mois_evt"].fillna("Date non lue")
    tab["Par_mois"] = par_mois[["mois_evt", "nb_gestes", "nb_contrats", "nb_beneficiaires",
                                "nb_personnes_tous_titulaires", "nb_gestes_comptes_joints",
                                "part_comptes_joints", "montant_total", "montant_moyen",
                                "montant_median", "nb_gestes_cumules", "montant_cumule"]]

    # --- Distribution des montants ---
    niveaux = [0.01, 0.05, 0.10, 0.25, 0.50, 0.75, 0.90, 0.95, 0.99]
    valeurs = ev.filter(F.col(COL_MNT).isNotNull()).approxQuantile(COL_MNT, niveaux, 0.0001)
    tab["Quantiles"] = pd.DataFrame({"Quantile": ["P{}".format(int(q * 100)) for q in niveaux],
                                     "Montant (€)": valeurs})
    tranches = (ev.groupBy("tranche_mnt").agg(F.count("*").alias("nb_gestes"),
                                              F.sum(COL_MNT).alias("montant_total"))
                  .toPandas().sort_values("tranche_mnt"))
    tranches["part_gestes"] = tranches["nb_gestes"] / tranches["nb_gestes"].sum()
    tranches["part_montant"] = tranches["montant_total"] / tranches["montant_total"].sum()
    tab["Tranches"] = tranches.rename(columns={"tranche_mnt": "tranche_montant"})

    # --- Comptes joints vs individuels ---
    joints = (ev.groupBy("type_compte").agg(
        F.countDistinct(COL_CNT).alias("nb_contrats"),
        F.count("*").alias("nb_gestes"),
        *stats_montant(ev)).toPandas().sort_values("type_compte"))
    joints["part_contrats"] = joints["nb_contrats"] / joints["nb_contrats"].sum()
    joints["gestes_par_contrat"] = joints["nb_gestes"] / joints["nb_contrats"]
    tab["Comptes_joints"] = joints

    # --- Récurrence : combien de gestes par contrat ---
    par_cnt = ev.groupBy(COL_CNT).agg(F.count("*").alias("n"), F.sum(COL_MNT).alias("mnt"))
    recur = (par_cnt.withColumn("nb_gestes_par_contrat",
                                F.when(F.col("n") >= 5, "5 et +").otherwise(F.col("n").cast("string")))
             .groupBy("nb_gestes_par_contrat")
             .agg(F.count("*").alias("nb_contrats"), F.avg("mnt").alias("montant_cumule_moyen"))
             .toPandas().sort_values("nb_gestes_par_contrat"))
    recur["part_contrats"] = recur["nb_contrats"] / recur["nb_contrats"].sum()
    tab["Recurrence"] = recur

    # --- Jour de la semaine ---
    jours = (ev.filter(F.col("date_evt").isNotNull())
               .withColumn("num_jour", F.dayofweek("date_evt"))
               .groupBy("num_jour").agg(F.count("*").alias("nb_gestes"), F.avg(COL_MNT).alias("montant_moyen"))
               .toPandas().sort_values("num_jour"))
    noms = {1: "7. Dimanche", 2: "1. Lundi", 3: "2. Mardi", 4: "3. Mercredi", 5: "4. Jeudi", 6: "5. Vendredi", 7: "6. Samedi"}
    jours["jour"] = jours["num_jour"].map(noms)
    jours["part_gestes"] = jours["nb_gestes"] / jours["nb_gestes"].sum()
    tab["Jour_semaine"] = jours.sort_values("jour")[["jour", "nb_gestes", "part_gestes", "montant_moyen"]]

    # --- Segment d'engagement du bénéficiaire principal ---
    if COL_SEG in df.columns:
        seg = (ev.groupBy(COL_SEG).agg(F.countDistinct(COL_PRS).alias("nb_beneficiaires"),
                                       F.count("*").alias("nb_gestes"), *stats_montant(ev))
                 .toPandas().sort_values(COL_SEG))
        seg["part_beneficiaires"] = seg["nb_beneficiaires"] / seg["nb_beneficiaires"].sum()
        tab["Engagement"] = seg

    # --- Contrôles qualité ---
    nb_rang1 = df.filter(F.col(COL_RANK) == 1).count()
    ctrl = [
        ("Lignes du dataset (toutes personnes)", df.count()),
        ("Lignes de rang 1 avant dédoublonnage", nb_rang1),
        ("Gestes retenus (une ligne par geste)", ev.count()),
        ("Lignes sans id personne", df.filter(F.col(COL_PRS).isNull()).count()),
        ("Dates non lues (date_evt vide)", ev.filter(F.col("date_evt").isNull()).count()),
        ("Montants manquants", ev.filter(F.col(COL_MNT).isNull()).count()),
        ("Montants nuls ou négatifs", ev.filter(F.col(COL_MNT) <= 0).count()),
        ("Contrats absents du RIB", ev.filter(F.instr(F.col(COL_RIB), F.col(COL_CNT)) == 0).count()),
        ("Contrats à 3 titulaires et +", df.filter(F.col("nb_titulaires") >= 3).select(COL_CNT).distinct().count()),
    ]
    exemples = (ev.filter(F.col("date_evt").isNull() & F.col(COL_DATE).isNotNull())
                  .select(F.col(COL_DATE).cast("string").alias("v")).distinct().limit(5).toPandas()["v"].tolist())
    if exemples:
        ctrl.append(("Exemples de dates non lues", " | ".join(exemples)))
    tab["Controles"] = pd.DataFrame(ctrl, columns=["Contrôle", "Valeur"])

    df.unpersist()
    ev.unpersist()
    return tab

