LIBELLES = {
    "mois_evt": "Mois", "nb_gestes": "Nb gestes co", "nb_contrats": "Nb contrats",
    "nb_beneficiaires": "Nb bénéficiaires (rang 1)", "nb_personnes_tous_titulaires": "Nb personnes (tous titulaires)",
    "nb_gestes_comptes_joints": "Nb gestes comptes joints", "part_comptes_joints": "Part comptes joints",
    "montant_total": "Montant total (€)", "montant_moyen": "Montant moyen (€)", "montant_median": "Montant médian (€)",
    "nb_gestes_cumules": "Nb gestes cumulés", "montant_cumule": "Montant cumulé (€)",
    "tranche_montant": "Tranche de montant", "part_gestes": "Part des gestes", "part_montant": "Part du montant",
    "type_compte": "Type de compte", "part_contrats": "Part des contrats", "gestes_par_contrat": "Gestes par contrat",
    "nb_gestes_par_contrat": "Nb gestes par contrat", "montant_cumule_moyen": "Montant cumulé moyen (€)",
    "jour": "Jour", "part_beneficiaires": "Part des bénéficiaires", COL_SEG: "Segment d'engagement",
}
TITRES = {
    "Synthese": "Synthèse des gestes co", "Par_mois": "Évolution mensuelle",
    "Distribution_montants": "Distribution des montants", "Comptes_joints": "Comptes joints vs individuels",
    "Recurrence": "Nombre de gestes co par contrat", "Jour_semaine": "Répartition par jour de la semaine",
    "Engagement": "Bénéficiaires par segment d'engagement", "Controles": "Contrôles qualité des données",
}


def ecrire_excel(tab, sortie):
    from openpyxl import Workbook
    from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
    from openpyxl.chart import BarChart, LineChart, Reference
    from openpyxl.utils import get_column_letter

    bleu, gris = "1F4E79", "D9D9D9"
    entete = PatternFill("solid", fgColor=bleu)
    bord = Border(bottom=Side(style="thin", color=gris))

    def format_col(nom):
        if nom.startswith("part_") or nom.startswith("Part"):
            return "0.0%"
        if "montant" in nom or "Montant" in nom:
            return '#,##0.00 "€"'
        if nom == "gestes_par_contrat":
            return "0.00"
        return "#,##0"

    def ecrire_tableau(ws, df, ligne, titre=None):
        if titre:
            ws.cell(row=ligne, column=1, value=titre).font = Font(bold=True, size=11, color=bleu)
            ligne += 1
        for j, c in enumerate(df.columns, 1):
            cell = ws.cell(row=ligne, column=j, value=LIBELLES.get(c, c))
            cell.fill, cell.font = entete, Font(bold=True, color="FFFFFF")
            cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
        debut = ligne + 1
        for i, rang in enumerate(df.itertuples(index=False), debut):
            for j, (c, v) in enumerate(zip(df.columns, rang), 1):
                v = None if (isinstance(v, float) and pd.isna(v)) else v
                cell = ws.cell(row=i, column=j, value=v)
                cell.border = bord
                if isinstance(v, (int, float)) and not isinstance(v, bool):
                    cell.number_format = format_col(c)
        return debut, debut + len(df) - 1

    def finaliser(ws, largeur_min=12):
        for col in ws.columns:
            taille = max(len(str(c.value)) if c.value is not None else 0 for c in col)
            ws.column_dimensions[get_column_letter(col[0].column)].width = min(max(largeur_min, taille + 2), 45)

    wb = Workbook()
    wb.remove(wb.active)
    feuilles = ["Synthese", "Par_mois", "Distribution_montants", "Comptes_joints",
                "Recurrence", "Jour_semaine", "Engagement", "Controles"]
    for nom in feuilles:
        if nom == "Distribution_montants":
            if "Quantiles" not in tab:
                continue
        elif nom not in tab:
            continue
        ws = wb.create_sheet(nom)
        ws.cell(row=1, column=1, value=TITRES[nom]).font = Font(bold=True, size=14, color=bleu)
        ws.cell(row=2, column=1, value="Généré le {}".format(dt.date.today().strftime("%d/%m/%Y"))).font = Font(italic=True, color="808080")

        if nom == "Synthese":
            d, f = ecrire_tableau(ws, tab[nom], 4)
            for r in range(d, f + 1):
                lib = ws.cell(row=r, column=1).value
                v = ws.cell(row=r, column=2)
                if isinstance(v.value, (int, float)):
                    v.number_format = '#,##0.00 "€"' if "€" in lib else "#,##0"
        elif nom == "Distribution_montants":
            d1, f1 = ecrire_tableau(ws, tab["Quantiles"], 4, "Quantiles des montants")
            d2, f2 = ecrire_tableau(ws, tab["Tranches"], f1 + 3, "Répartition par tranche de montant")
            graph = BarChart()
            graph.title, graph.y_axis.title = "Nombre de gestes par tranche", "Nb gestes"
            graph.add_data(Reference(ws, min_col=2, min_row=d2 - 1, max_row=f2), titles_from_data=True)
            graph.set_categories(Reference(ws, min_col=1, min_row=d2, max_row=f2))
            graph.legend, graph.height, graph.width = None, 8, 18
            ws.add_chart(graph, "H4")
        else:
            d, f = ecrire_tableau(ws, tab[nom], 4)
            if nom == "Par_mois" and f >= d:
                graph = LineChart()
                graph.title, graph.y_axis.title = "Nombre de gestes co par mois", "Nb gestes"
                graph.add_data(Reference(ws, min_col=2, min_row=d - 1, max_row=f), titles_from_data=True)
                graph.add_data(Reference(ws, min_col=4, min_row=d - 1, max_row=f), titles_from_data=True)
                graph.set_categories(Reference(ws, min_col=1, min_row=d, max_row=f))
                graph.height, graph.width = 9, 22
                ws.add_chart(graph, "B{}".format(f + 3))
        ws.freeze_panes = "A5" if nom != "Distribution_montants" else None
        finaliser(ws)

    ws = wb.create_sheet("Definitions")
    notes = [
        ("Geste co", "Une ligne du dataset après conservation de la personne de rang 1 (la plus engagée)."),
        ("Bénéficiaire principal", "Personne de rang 1 sur le contrat au moment du geste."),
        ("Tous titulaires", "Toutes les personnes rattachées au contrat, quel que soit leur rang."),
        ("Compte joint", "Contrat rattaché à au moins 2 personnes distinctes dans le dataset."),
        ("Mois", "Mois de la date d'événement ({}).".format(COL_DATE)),
        ("Médiane / quantiles", "Calculés de façon approchée par Spark (précision 0,01 %)."),
    ]
    ws.cell(row=1, column=1, value="Définitions").font = Font(bold=True, size=14, color=bleu)
    ecrire_tableau(ws, pd.DataFrame(notes, columns=["Terme", "Définition"]), 3)
    ws.column_dimensions["A"].width, ws.column_dimensions["B"].width = 25, 90

    wb.save(sortie)

# -------------------------------------------------------------------------------- NOTEBOOK-CELL: CODE
# ============================== EXÉCUTION DANS DATAIKU =======================
if dataiku is not None:
    sc = SparkContext.getOrCreate()
    sqlContext = SQLContext(sc)

    gestes = dkuspark.get_dataframe(sqlContext, dataiku.Dataset(DATASET_ENTREE))
    tableaux = calculer_tableaux(gestes)

    tampon = io.BytesIO()
    ecrire_excel(tableaux, tampon)
    with dataiku.Folder(DOSSIER_SORTIE).get_writer(NOM_FICHIER) as w:
        w.write(tampon.getvalue())
    print("Rapport écrit :", NOM_FICHIER)
