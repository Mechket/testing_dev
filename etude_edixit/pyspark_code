# ============================================================
# Fonction pour transformer un YYYYMM en vraie date
# ============================================================
# Exemple :
# "202501" -> 2025-01-01
# "202512" -> 2025-12-01
#
# Cela permet ensuite d'utiliser add_months() correctement,
# notamment lors des changements d'année.
# ============================================================

def yyyymm_to_date(col_name):
    return F.to_date(
        F.concat(
            F.col(col_name).cast("string"),
            F.lit("01")
        ),
        "yyyyMMdd"
    )


# ============================================================
# 2. Fonction pour récupérer les métriques à un horizon donné
# ============================================================

def get_metrics_at_horizon(base_df, horizon, suffix):

    # --------------------------------------------------------
    # Bloc marketing :
    # annee_mois_part est en YYYYMM
    # On le transforme en vraie date puis on décale de
    # "horizon" mois par rapport au mois marketing.
    # --------------------------------------------------------

    marketing = (
        base_df
        .withColumn(
            "_mois_date",
            yyyymm_to_date("annee_mois_part")
        )
        .withColumn(
            "_target_date",
            F.add_months(
                F.col("_mois_date"),
                horizon
            )
        )
    )

    # --------------------------------------------------------
    # Données d'entretien :
    # entretien_mois est également en YYYYMM
    # --------------------------------------------------------

    entretiens = (
        beneficiaires_eDixit_df
        .withColumn(
            "_entretien_date",
            yyyymm_to_date("entretien_mois")
        )
    )

    # --------------------------------------------------------
    # Jointure :
    #
    # id_prs du bloc marketing
    # =
    # id_prs_edixit du bénéficiaire
    #
    # ET
    #
    # mois marketing décalé de "horizon"
    # =
    # mois d'entretien
    #
    # Exemple :
    # entretien = 202501
    #
    # horizon 0 -> marketing 202501
    # horizon 1 -> marketing 202502
    # horizon 3 -> marketing 202504
    # horizon 6 -> marketing 202507
    # --------------------------------------------------------

    result = (
        marketing
        .join(
            entretiens.select(
                "id_prs_edixit",
                "_entretien_date"
            ),
            (
                F.col("id_prs") == F.col("id_prs_edixit")
            )
            &
            (
                F.col("_target_date") == F.col("_entretien_date")
            ),
            "inner"
        )
        .drop(
            "id_prs_edixit",
            "_mois_date",
            "_target_date",
            "_entretien_date"
        )
    )

    return result


