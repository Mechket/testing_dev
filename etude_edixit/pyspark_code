# 6. Fonction pour créer les cohortes (adaptée pour les non-bénéficiaires)
def create_cohort_table(base_df, reference_df, id_col, date_col, metrics, cohort_suffixes):
    cohort_dfs = {}

    # Entretien -> vraie date (une seule fois)
    reference_norm = reference_df.select(
        "id_prs_non_benef",
        F.to_date(F.col("entretien_mois").cast("string"), "yyyyMM").alias("entretien_date"),
    )

    # Mois marketing -> vraie date (une seule fois)
    base_norm = base_df.withColumn(
        "marketing_date",
        F.to_date(F.col(date_col).cast("string"), "yyyyMM"),
    )

    for horizon, suffix in cohort_suffixes:
        # mois marketing visé = mois d'entretien + horizon (APRÈS l'entretien)
        ref_target = reference_norm.withColumn(
            "target_date", F.add_months(F.col("entretien_date"), horizon)
        )

        cohort = (
            base_norm.join(
                ref_target,
                (F.col(id_col) == F.col("id_prs_non_benef"))
                & (F.col("marketing_date") == F.col("target_date")),
                "inner",
            )
            .drop("id_prs_non_benef", "entretien_date", "target_date", "marketing_date", date_col)
        )

        for metric in metrics:
            cohort = cohort.withColumnRenamed(metric, f"{metric}_{suffix}")

        cohort_dfs[suffix] = cohort

    return cohort_dfs
