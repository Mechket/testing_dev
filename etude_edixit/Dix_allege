def remplir(ws, ligne, col_debut, col_fin, couleur):
    for c in range(col_debut, col_fin + 1):
        ws.cell(row=ligne, column=c).fill = PatternFill("solid", fgColor=couleur)
        ws.cell(row=ligne, column=c).border = BORD


def bloc_vertical(ws, debut, fin, texte):
    ws.merge_cells(start_row=debut, start_column=COL_BLOC, end_row=fin, end_column=COL_BLOC)
    c = ws.cell(row=debut, column=COL_BLOC, value=texte)
    c.font = Font(bold=True, color=BLANC, size=11)
    c.fill = PatternFill("solid", fgColor=BLEU_FONCE)
    # Libellé en haut pour les longs blocs, sinon il serait invisible à l'écran
    c.alignment = Alignment(horizontal="center", vertical="center" if fin - debut < 15 else "top",
                            wrap_text=True)
    for r in range(debut, fin + 1):
        ws.cell(row=r, column=COL_BLOC).fill = PatternFill("solid", fgColor=BLEU_FONCE)


def ligne_titre(ws, ligne, texte):
    """Ligne d'indicateur (bleu moyen, comme 'SF totale' chez la collègue)."""
    remplir(ws, ligne, COL_LIB, COL_FIN, BLEU)
    c = ws.cell(row=ligne, column=COL_LIB, value=texte)
    c.font = Font(bold=True, color=BLANC)


def ligne_valeurs(ws, ligne, libelle, valeurs, fmt, gras=False):
    remplir(ws, ligne, COL_LIB, COL_FIN, BLEU_TRES_CLAIR)
    c = ws.cell(row=ligne, column=COL_LIB, value="    " + libelle)
    c.fill = PatternFill("solid", fgColor=BLEU_CLAIR)
    c.font = Font(bold=gras)
    for j, v in enumerate(valeurs, COL_DEBUT):
        cell = ws.cell(row=ligne, column=j, value=None if pd.isna(v) else float(v))
        cell.number_format = fmt
        cell.alignment = Alignment(horizontal="center")
        cell.font = Font(bold=gras)


def ligne_ecart(ws, ligne, ligne_b, ligne_n):
    """Écart en % calculé par formule Excel : bénéf / non-bénéf - 1."""
    remplir(ws, ligne, COL_LIB, COL_FIN, BLEU_TRES_CLAIR)
    c = ws.cell(row=ligne, column=COL_LIB, value="    Écart bénéf. / non-bénéf.")
    c.fill = PatternFill("solid", fgColor=BLEU_CLAIR)
    c.font = Font(bold=True, italic=True)
    for j in range(COL_DEBUT, COL_FIN + 1):
        L = get_column_letter(j)
        cell = ws.cell(row=ligne, column=j,
                       value=f'=IFERROR({L}{ligne_b}/{L}{ligne_n}-1,"")')
        cell.number_format = FORMAT_PCT
        cell.alignment = Alignment(horizontal="center")
        cell.font = Font(bold=True, italic=True)


