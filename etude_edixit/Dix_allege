# 4. CALCULS
# ============================================================

def statistique(df, colonne, stat):
    if colonne not in df.columns:
        return np.nan
    s = pd.to_numeric(df[colonne], errors="coerce").dropna()
    if len(s) == 0:
        return np.nan
    return {"moyenne": s.mean(), "mediane": s.median(), "total": s.sum()}[stat]


def effectif(df, suffixe):
    """Clients ayant au moins un indicateur renseigné à cet horizon."""
    cols = [f"{m}{suffixe}" for m in METRICS if f"{m}{suffixe}" in df.columns]
    if not cols:
        return np.nan
    return int(df[cols].notna().any(axis=1).sum())


