    t_evo.fill = PatternFill("solid", fgColor="375623")
    t_evo.alignment = Alignment(horizontal="left")

    ligne += 1

    entetes_evo = [
        "Horizon",
        "Évol. % bénéficiaires",
        "Évol. % non-bénéficiaires",
        "Écart (points)",
    ]

    for col, libelle in enumerate(entetes_evo, start=1):

        cell = ws.cell(row=ligne, column=col)
        cell.value = libelle
        cell.font = Font(bold=True, color=BLANC)
        cell.fill = PatternFill("solid", fgColor="375623")
