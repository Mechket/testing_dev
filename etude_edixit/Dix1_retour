        min_col=COL_GRAPH,
        min_row=ligne_entete_graph + 1,
        max_row=derniere_ligne_graph
    )

    chart.add_data(data_ref, titles_from_data=True)
    chart.set_categories(cats_ref)

    # Mise en forme : couleur par mois, pointillés pour non-bénéficiaires
    for i, serie in enumerate(chart.series):

        couleur = PALETTE[(i // 2) % len(PALETTE)]

        serie.smooth = False
        serie.graphicalProperties.line.solidFill = couleur
        serie.graphicalProperties.line.width = 22000

        if i % 2 == 1:
            serie.graphicalProperties.line.dashStyle = "dash"
            serie.graphicalProperties.line.width = 16000

    ws.add_chart(
        chart,
        f"{get_column_letter(COL_GRAPH)}{derniere_ligne_graph + 3}"
    )

    # --------------------------------------------------------
    # TABLEAU RECAPITULATIF GLOBAL
    # --------------------------------------------------------

    ligne = 4

    ligne = ecrire_tableau(
        ws,
        ligne,
        "RÉCAPITULATIF GLOBAL — tous mois d'entretien confondus",
        stats_global,
        ROUGE
    )

    ligne += 2

    # --------------------------------------------------------
    # UN TABLEAU PAR MOIS D'ENTRETIEN
    # --------------------------------------------------------

    for mois in MOIS_ENTRETIEN:

        ligne = ecrire_tableau(
            ws,
            ligne,
            f"Mois d'entretien : {mois}",
            stats_par_mois[mois],
            BLEU_FONCE
        )

        ligne += 2

    # ========================================================
    # LARGEUR DES COLONNES
    # ========================================================

    ws.column_dimensions["A"].width = 34

    for col in range(2, NB_COLS + 1):
        ws.column_dimensions[get_column_letter(col)].width = 16

    ws.column_dimensions[get_column_letter(COL_GRAPH)].width = 12

    for col in range(COL_GRAPH + 1, derniere_col_serie + 1):
        ws.column_dimensions[get_column_letter(col)].width = 13

    # ========================================================
    # FIGER LES VOLETS
    # ========================================================

    ws.freeze_panes = "B5"


# ============================================================
# 14. SAUVEGARDE
# ============================================================

wb.save(FICHIER_SORTIE)

print("\n" + "=" * 60)
print("TERMINÉ")
print("=" * 60)
print(f"Fichier créé : {Path(FICHIER_SORTIE).resolve()}")
