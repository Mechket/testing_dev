    col_m = list(HORIZONS.keys()).index("M") + 2
    ws.cell(row=ligne, column=col_m).fill = PatternFill("solid", fgColor=BLEU)

    ligne += 1

    # --------------------------------------------------------
    # LIGNES DE STATISTIQUES
    # --------------------------------------------------------

    for nom_ligne in ORDRE_LIGNES:

        lib = ws.cell(row=ligne, column=1)
        lib.value = nom_ligne
        lib.font = Font(
            bold=("Écart" in nom_ligne or "Nombre" in nom_ligne)
        )

