# 11. CALCUL D'UN BLOC DE STATISTIQUES
# ============================================================

ORDRE_LIGNES = [
    "Nombre bénéficiaires",
    "Nombre non-bénéficiaires",
    "Moyenne bénéficiaires",
    "Moyenne non-bénéficiaires",
    "Écart moyenne",
    "Total bénéficiaires",
    "Total non-bénéficiaires",
    "Écart total",
    "Médiane bénéficiaires",
    "Médiane non-bénéficiaires",
    "Écart médiane",
]

CLES_EVOLUTION = [
    "Évolution % bénéficiaires (vs M)",
    "Évolution % non-bénéficiaires (vs M)",
    "Écart d'évolution (points)",
]


def calculer_bloc(metric, mois=None):
    """
    Calcule toutes les statistiques d'un tableau
    (un mois d'entretien, ou tous mois confondus si mois vaut None).
    """

    lignes_stats = {nom: {} for nom in ORDRE_LIGNES + CLES_EVOLUTION}

    for horizon, suffixe in HORIZONS.items():

        colonne_metric = f"{metric}{suffixe}"

        sb = calculer_statistiques(df_benef, colonne_metric, mois)
        sn = calculer_statistiques(df_non_benef, colonne_metric, mois)

        lignes_stats["Nombre bénéficiaires"][horizon] = sb["nombre"]
        lignes_stats["Nombre non-bénéficiaires"][horizon] = sn["nombre"]

        lignes_stats["Moyenne bénéficiaires"][horizon] = sb["moyenne"]
        lignes_stats["Moyenne non-bénéficiaires"][horizon] = sn["moyenne"]

        lignes_stats["Total bénéficiaires"][horizon] = sb["total"]
        lignes_stats["Total non-bénéficiaires"][horizon] = sn["total"]

        lignes_stats["Médiane bénéficiaires"][horizon] = sb["mediane"]
        lignes_stats["Médiane non-bénéficiaires"][horizon] = sn["mediane"]

        for cle, champ in [
            ("Écart moyenne", "moyenne"),
            ("Écart total", "total"),
            ("Écart médiane", "mediane"),
        ]:
            if pd.notna(sb[champ]) and pd.notna(sn[champ]):
                lignes_stats[cle][horizon] = sb[champ] - sn[champ]
            else:
                lignes_stats[cle][horizon] = np.nan

    # --------------------------------------------------------
    # EVOLUTIONS PAR RAPPORT A M
    # --------------------------------------------------------

    base_b = ("Moyenne bénéficiaires" if BASE_EVOLUTION == "moyenne"
              else "Total bénéficiaires")
    base_n = ("Moyenne non-bénéficiaires" if BASE_EVOLUTION == "moyenne"
              else "Total non-bénéficiaires")

    ref_b = lignes_stats[base_b].get("M", np.nan)
    ref_n = lignes_stats[base_n].get("M", np.nan)

    for horizon in HORIZONS.keys():

        ev_b = evolution_pct(lignes_stats[base_b][horizon], ref_b)
        ev_n = evolution_pct(lignes_stats[base_n][horizon], ref_n)

        lignes_stats["Évolution % bénéficiaires (vs M)"][horizon] = ev_b
        lignes_stats["Évolution % non-bénéficiaires (vs M)"][horizon] = ev_n

        if pd.notna(ev_b) and pd.notna(ev_n):
            lignes_stats["Écart d'évolution (points)"][horizon] = ev_b - ev_n
        else:
            lignes_stats["Écart d'évolution (points)"][horizon] = np.nan

    return lignes_stats


